NODE_ENV=development
PORT=4000
DATABASE_URL="file:./dev.db"

# Generate strong random values, e.g.: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Keep these two DIFFERENT from each other.
JWT_ACCESS_SECRET=changeme-access-secret
JWT_REFRESH_SECRET=changeme-refresh-secret

# Access tokens are short-lived and sent with each request (Authorization header).
JWT_ACCESS_EXPIRES_IN=15m
# Refresh tokens are long-lived and stored in an httpOnly cookie.
JWT_REFRESH_EXPIRES_IN=30d

# Optional: set this in production if the API and frontend share a parent domain.
# COOKIE_DOMAIN=.example.com

# Optional: comma-separated list of allowed frontend origins, e.g.:
# CORS_ORIGIN=http://localhost:5173,https://app.example.com
# If unset, all origins are allowed (fine for local dev only).
CORS_ORIGIN=
